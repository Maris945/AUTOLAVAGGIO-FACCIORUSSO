<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autolavaggio Facciorusso | Service Car</title>
    <style>
        :root {
            --primary: #0056b3;
            --secondary: #00b4d8;
            --dark: #1e293b;
            --light: #f8fafc;
            --whatsapp: #25D366;
            --google-red: #ea4335;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
        }

        body {
            background-color: var(--light);
            color: var(--dark);
            line-height: 1.6;
        }

        header {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            color: white;
            padding: 50px 20px;
            text-align: center;
            border-bottom: 5px solid var(--secondary);
        }

        .main-title {
            font-size: 2.6rem;
            font-weight: 800;
            text-transform: uppercase;
            color: #ffffff;
            margin-bottom: 5px;
            letter-spacing: 1px;
        }

        .sub-title {
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--secondary);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .tagline {
            font-size: 1.1rem;
            background: rgba(255, 255, 255, 0.15);
            display: inline-block;
            padding: 6px 20px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        /* Sezione Info Rapide */
        .info-section {
            background: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .info-item {
            padding: 10px;
        }

        .info-item h5 {
            font-size: 1.1rem;
            color: var(--primary);
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        /* Griglia dei Servizi */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border-top: 5px solid var(--primary);
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card h3 {
            font-size: 1.4rem;
            margin-bottom: 20px;
            color: #0f172a;
            text-transform: uppercase;
        }

        .services-list {
            list-style: none;
            text-align: left;
            margin-bottom: 25px;
            flex-grow: 1;
        }

        .services-list li {
            padding: 10px 0;
            border-bottom: 1px solid #f1f5f9;
            font-size: 1rem;
        }

        .services-list li::before {
            content: "✓ ";
            color: var(--secondary);
            font-weight: bold;
            margin-right: 8px;
        }

        /* Pulsanti */
        .btn {
            display: block;
            width: 100%;
            padding: 15px;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: bold;
            text-decoration: none;
            text-align: center;
            cursor: pointer;
            border: none;
            transition: transform 0.2s, opacity 0.2s;
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn-whatsapp {
            background-color: var(--whatsapp);
            color: white;
        }

        .btn-review {
            background-color: var(--google-red);
            color: white;
        }

        /* Finestra Pop-up (Modal) */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            z-index: 1000;
            padding: 20px;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal {
            background: white;
            border-radius: 20px;
            max-width: 450px;
            width: 100%;
            padding: 30px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
            position: relative;
            text-align: center;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.8rem;
            background: none;
            border: none;
            cursor: pointer;
            color: #94a3b8;
        }

        .modal-header h4 {
            font-size: 1.4rem;
            color: var(--dark);
            margin-bottom: 5px;
        }

        .booking-option {
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px;
            margin-top: 15px;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
            text-align: left;
        }

        .booking-option:hover {
            border-color: var(--secondary);
            background: #f0fdfa;
        }

        .booking-option .title {
            font-weight: 600;
            color: var(--dark);
            font-size: 1.1rem;
        }

        .booking-option .desc {
            font-size: 0.85rem;
            color: #64748b;
            margin-top: 2px;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #64748b;
            font-size: 0.9rem;
            background: white;
            border-top: 1px solid #e2e8f0;
        }

        /* Pulsante fluttuante WhatsApp fisso in basso */
        .floating-wsp {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background-color: var(--whatsapp);
            color: white;
            padding: 15px 25px;
            border-radius: 50px;
            font-weight: bold;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.25);
            z-index: 99;
            font-size: 1rem;
        }

        @media (max-width: 600px) {
            .main-title { font-size: 2rem; }
            .sub-title { font-size: 1.2rem; }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-container">
            <h1 class="main-title">Autolavaggio Facciorusso</h1>
            <h2 class="sub-title">Service Car</h2>
            <p class="tagline">💧 Lavaggio Professionale & Pneumatici</p>
        </div>
    </header>

    <div class="container">
        
        <div class="info-section">
            <div class="info-grid">
                <div class="info-item">
                    <h5>📍 Posizione</h5>
                    <p>Vieni a trovarci in sede per un servizio impeccabile e rapido.</p>
                </div>
                <div class="info-item">
                    <h5>⏰ Orari</h5>
                    <p>Lunedì - Sabato.<br>Siamo a tua completa disposizione.</p>
                </div>
                <div class="info-item">
                    <h5>⭐ Recensioni</h5>
                    <p>Clicca sulla scheda dedicata per lasciarci la tua valutazione su Google!</p>
                </div>
            </div>
        </div>

        <div class="grid">
            
            <div class="card">
                <div>
                    <h3>🧽 Autolavaggio</h3>
                    <ul class="services-list">
                        <li>Lavaggio interni ed esterni accurato</li>
                        <li>Sanificazione completa dell'abitacolo</li>
                        <li>Trattamento plastiche e sedili in pelle</li>
                        <li>Lavaggio dettagliato di cerchi e gomme</li>
                    </ul>
                </div>
                <button class="btn btn-whatsapp" onclick="openBooking('Autolavaggio')">
                    🟢 Prenota Lavaggio
                </button>
            </div>

            <div class="card">
                <div>
                    <h3>🛞 Sostituzione Pneumatici</h3>
                    <ul class="services-list">
                        <li>Vendita e montaggio pneumatici</li>
                        <li>Equilibratura e convergenza computerizzata</li>
                        <li>Riparazione rapida forature</li>
                        <li>Controllo pressione e stato d'usura gratuito</li>
                    </ul>
                </div>
                <button class="btn btn-whatsapp" onclick="openBooking('Servizio Pneumatici')">
                    🟢 Prenota Servizio Gomme
                </button>
            </div>

            <div class="card" style="border-top-color: var(--google-red);">
                <div>
                    <h3>⭐ Recensioni Google</h3>
                    <p style="margin-bottom: 25px; color: #64748b; font-size: 1.05rem;">
                        La tua opinione è importante! Clicca sul tasto sotto per accedere alla pagina ufficiale estratta dal nostro QR code e lasciarci un voto.
                    </p>
                </div>
                <a href="https://share.google/3UsOy3KofUqfwWklu" target="_blank" class="btn btn-review">
                    🔴 Lascia una Recensione
                </a>
            </div>

        </div>

    </div>

    <div class="modal-overlay" id="bookingModal">
        <div class="modal">
            <button class="modal-close" onclick="closeBooking()">×</button>
            <div class="modal-header">
                <h4>Scegli quando venire</h4>
                <p style="color: #64748b; font-size: 0.95rem;" id="modalServiceType">Servizio selezionato</p>
            </div>
            
            <div class="booking-option" onclick="sendWhatsApp('al più presto')">
                <div class="title">⚡ Prima disponibilità</div>
                <div class="desc">Richiedi il primo appuntamento utile libero</div>
            </div>

            <div class="booking-option" onclick="sendWhatsApp('nei prossimi giorni di questa settimana')">
                <div class="title">📅 Prenota in settimana</div>
                <div class="desc">Fissa un giorno specifico nei prossimi giorni</div>
            </div>

            <div class="booking-option" onclick="sendWhatsApp('per richiedere informazioni e prezzi')">
                <div class="title">💬 Informazioni / Preventivo</div>
                <div class="desc">Chiedi dettagli sui prezzi o trattamenti speciali</div>
            </div>
        </div>
    </div>

    <a href="https://wa.me/393687889679?text=Ciao%20Autolavaggio%20Facciorusso,%20vorrei%20maggiori%20informazioni%20sui%20vostri%20servizi." target="_blank" class="floating-wsp">
        💬 Scrivici ora
    </a>

    <footer>
        <p>&copy; 2026 Autolavaggio Facciorusso - Service Car. Tutti i diritti riservati.</p>
    </footer>

    <script>
        let currentService = '';
        const phoneNumber = '393687889679'; // Numero corretto impostato

        function openBooking(service) {
            currentService = service;
            document.getElementById('modalServiceType').innerText = 'Stai richiedendo: ' + service;
            document.getElementById('bookingModal').classList.add('active');
        }

        function closeBooking() {
            document.getElementById('bookingModal').classList.remove('remove');
            document.getElementById('bookingModal').classList.remove('active');
        }

        function sendWhatsApp(preference) {
            let message = `Ciao Autolavaggio Facciorusso! Vorrei prenotare un servizio di *${currentService}* ${preference}. Quali sono le prossime disponibilità?`;
            let encodedMessage = encodeURIComponent(message);
            let whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
            
            window.open(whatsappUrl, '_blank');
            closeBooking();
        }

        // Chiudi cliccando fuori dal pop-up
        document.getElementById('bookingModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeBooking();
            }
        });
    </script>
</body>
</html>
