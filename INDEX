<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facciorusso Service Car | Autolavaggio & Pneumatici</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #0056b3;
            --secondary: #00b4d8;
            --dark: #1e293b;
            --light: #f8fafc;
            --whatsapp: #25D366;
            --accent: #ffb703;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--light);
            color: var(--dark);
            line-height: 1.6;
        }

        header {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
            border-bottom: 5px solid var(--secondary);
            position: relative;
            overflow: hidden;
        }

        header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle, transparent 20%, #0f172a 80%);
            opacity: 0.4;
        }

        .logo-container {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }

        .main-title {
            font-size: 2.8rem;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            color: #ffffff;
            margin-bottom: 5px;
        }

        .sub-title {
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--secondary);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .tagline {
            font-size: 1.2rem;
            background: rgba(255, 255, 255, 0.1);
            display: inline-block;
            padding: 6px 20px;
            border-radius: 50px;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255,255,255,0.2);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-top: 4px solid var(--primary);
            text-align: center;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        .card-icon {
            font-size: 3rem;
            color: var(--secondary);
            margin-bottom: 15px;
        }

        .card h3 {
            font-size: 1.4rem;
            margin-bottom: 15px;
            color: #0f172a;
        }

        .services-list {
            list-style: none;
            text-align: left;
            margin-bottom: 20px;
        }

        .services-list li {
            padding: 8px 0;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
        }

        .services-list li i {
            color: var(--secondary);
            margin-right: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 28px;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            border: none;
            width: 100%;
        }

        .btn-whatsapp {
            background-color: var(--whatsapp);
            color: white;
            box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);
        }

        .btn-whatsapp:hover {
            background-color: #20ba5a;
            transform: scale(1.02);
        }

        .btn-review {
            background: linear-gradient(135deg, #ea4335 0%, #c5221f 100%);
            color: white;
            box-shadow: 0 6px 20px rgba(234, 67, 53, 0.3);
        }

        .btn-review:hover {
            opacity: 0.95;
            transform: scale(1.02);
        }

        /* Modal / Popup Styles */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            z-index: 1000;
            padding: 20px;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal {
            background: white;
            border-radius: 20px;
            max-width: 500px;
            width: 100%;
            padding: 30px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
            transform: scale(0.9);
            transition: transform 0.3s ease;
            position: relative;
        }

        .modal-overlay.active .modal {
            transform: scale(1);
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            background: none;
            border: none;
            cursor: pointer;
            color: #94a3b8;
        }

        .modal-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .modal-header i {
            font-size: 3.5rem;
            color: var(--whatsapp);
            margin-bottom: 10px;
        }

        .modal-header h4 {
            font-size: 1.5rem;
            color: var(--dark);
        }

        .booking-option {
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 15px;
            text-align: left;
        }

        .booking-option:hover {
            border-color: var(--secondary);
            background: #f0fdfa;
        }

        .booking-option i {
            font-size: 1.8rem;
            color: var(--primary);
        }

        .booking-option .title {
            font-weight: 600;
            color: var(--dark);
        }

        .booking-option .desc {
            font-size: 0.85rem;
            color: #64748b;
        }

        .info-section {
            background: white;
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 40px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

        .info-item i {
            font-size: 1.5rem;
            color: var(--primary);
            margin-top: 4px;
        }

        .info-item h5 {
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #64748b;
            font-size: 0.9rem;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
        }

        /* Floating WhatsApp Button */
        .floating-wsp {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: var(--whatsapp);
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            z-index: 99;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .floating-wsp:hover {
            transform: scale(1.1);
        }

        @media (max-width: 600px) {
            .main-title { font-size: 2rem; }
            .sub-title { font-size: 1.3rem; }
            .container { padding: 20px 15px; }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-container">
            <h1 class="main-title">Facciorusso</h1>
            <h2 class="sub-title">Service Car</h2>
            <p class="tagline"><i class="fas fa-tint"></i> Wash & Tyres</p>
        </div>
    </header>

    <div class="container">
        
        <!-- Info Rapide -->
        <div class="info-section">
            <div class="info-grid">
                <div class="info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <h5>Posizione</h5>
                        <p>Vieni a trovarci in sede per un servizio impeccabile.</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-clock"></i>
                    <div>
                        <h5>Orari di Apertura</h5>
                        <p>Lunedì - Sabato<br>Disponibili per ogni esigenza.</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-star"></i>
                    <div>
                        <h5>La Tua Opinione Conta</h5>
                        <p>Scansiona il codice o clicca sotto per lasciare una recensione su Google!</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid">
            <!-- Card Autolavaggio -->
            <div class="card">
                <div class="card-icon"><i class="fas fa-car-wash"></i></div>
                <h3>Autolavaggio Professionale</h3>
                <ul class="services-list">
                    <li><i class="fas fa-check-circle"></i> Lavaggio interni ed esterni accurato</li>
                    <li><i class="fas fa-check-circle"></i> Sanificazione abitacolo ad ozono</li>
                    <li><i class="fas fa-check-circle"></i> Trattamento plastiche e pelle</li>
                    <li><i class="fas fa-check-circle"></i> Lavaggio dettagliato cerchi e gomme</li>
                </ul>
                <button class="btn btn-whatsapp" onclick="openBooking('Autolavaggio')">
                    <i class="fab fa-whatsapp"></i> Prenota Lavaggio
                </button>
            </div>

            <!-- Card Pneumatici -->
            <div class="card">
                <div class="card-icon"><i class="fas fa-compact-disc"></i></div>
                <h3>Vendita Pneumatici e Cerchi</h3>
                <ul class="services-list">
                    <li><i class="fas fa-check-circle"></i> Sostituzione e riparazione pneumatici</li>
                    <li><i class="fas fa-check-circle"></i> Convergenza ed equilibratura computerizzata</li>
                    <li><i class="fas fa-check-circle"></i> Ampia gamma di cerchi in lega</li>
                    <li><i class="fas fa-check-circle"></i> Controllo pressione e stato d'usura</li>
                </ul>
                <button class="btn btn-whatsapp" onclick="openBooking('Servizio Pneumatici / Cerchi')">
                    <i class="fab fa-whatsapp"></i> Prenota Servizio Gomme
                </button>
            </div>

            <!-- Card Recensioni Google -->
            <div class="card" style="border-top-color: #ea4335;">
                <div class="card-icon" style="color: #ea4335;"><i class="fab fa-google"></i></div>
                <h3>Lascia una Recensione!</h3>
                <p style="margin-bottom: 25px; color: #64748b;">La tua opinione è fondamentale per aiutarci a crescere e offrire un servizio sempre migliore.</p>
                <a href="https://share.google/3UsOy3KofUqfwWklu" target="_blank" class="btn btn-review">
                    <i class="fas fa-star"></i> Lascia la Recensione
                </a>
            </div>
        </div>

    </div>

    <!-- Popup / Modal di prenotazione -->
    <div class="modal-overlay" id="bookingModal">
        <div class="modal">
            <button class="modal-close" onclick="closeBooking()">&times;</button>
            <div class="modal-header">
                <i class="fab fa-whatsapp"></i>
                <h4>Seleziona la tua preferenza</h4>
                <p style="color: #64748b; font-size: 0.9rem; margin-top: 5px;" id="modalServiceType">Servizio selezionato</p>
            </div>
            
            <div class="booking-option" onclick="sendWhatsApp('al più presto')">
                <i class="fas fa-bolt"></i>
                <div>
                    <div class="title">Prima disponibilità</div>
                    <div class="desc">Richiedi il primo appuntamento utile libero</div>
                </div>
            </div>

            <div class="booking-option" onclick="sendWhatsApp('per questa settimana')">
                <i class="fas fa-calendar-week"></i>
                <div>
                    <div class="title">In settimana</div>
                    <div class="desc">Scegli una data e un'ora nei prossimi giorni</div>
                </div>
            </div>

            <div class="booking-option" onclick="sendWhatsApp('per un preventivo personalizzato')">
                <i class="fas fa-file-invoice-dollar"></i>
                <div>
                    <div class="title">Richiedi Preventivo / Info</div>
                    <div class="desc">Chiedi informazioni dettagliate o prezzi speciali</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating WhatsApp -->
    <a href="https://wa.me/393330000000?text=Ciao%20Facciorusso%20Service%20Car,%20vorrei%20maggiori%20informazioni%20sui%20vostri%20servizi." target="_blank" class="floating-wsp" title="Contattaci su WhatsApp">
        <i class="fab fa-whatsapp"></i>
    </a>

    <footer>
        <p>&copy; 2026 Facciorusso Service Car. Tutti i diritti riservati.</p>
        <p style="font-size: 0.8rem; margin-top: 5px;">Progettato con cura professionale.</p>
    </footer>

    <script>
        let currentService = '';
        // Sostituisci questo numero con il numero di telefono reale dell'autolavaggio (con prefisso internazionale, es. 39...)
        const phoneNumber = '393330000000'; 

        function openBooking(service) {
            currentService = service;
            document.getElementById('modalServiceType').innerText = 'Stai prenotando per: ' + service;
            document.getElementById('bookingModal').classList.add('active');
        }

        function closeBooking() {
            document.getElementById('bookingModal').classList.remove('active');
        }

        function sendWhatsApp(timePreference) {
            let message = `Ciao Facciorusso Service Car! Vorrei prenotare un servizio di *${currentService}* ${timePreference}. Quali sono le prossime disponibilità?`;
            let encodedMessage = encodeURIComponent(message);
            let whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
            
            window.open(whatsappUrl, '_blank');
            closeBooking();
        }

        // Chiudi il modal cliccando fuori
        document.getElementById('bookingModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeBooking();
            }
        });
    </script>
</body>
</html>
